# Server Configuration
PORT=3001
NODE_ENV=development

# Anthropic API (Claude Opus 4.8 for menu extraction, translation, and chat)
ANTHROPIC_API_KEY=sk-ant-...

# Pexels API (free image search)
PEXELS_API_KEY=...

# Database
DATABASE_PATH=./data/menus.sqlite

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
