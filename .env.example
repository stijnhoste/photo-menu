# Server Configuration
PORT=3001
NODE_ENV=development
APP_NAME=menu.pictures
ALLOWED_ORIGINS=https://menu.pictures,https://www.menu.pictures,https://menu.photos,https://www.menu.photos

# Client build configuration
VITE_APP_NAME=menu.pictures
VITE_CANONICAL_URL=https://menu.pictures

# Anthropic API (Claude Opus 4.8 for menu extraction, translation, and chat)
ANTHROPIC_API_KEY=sk-ant-...

# Pexels API (free image search)
PEXELS_API_KEY=...

# Database
DATABASE_PATH=./data/menus.sqlite

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
